# Local dev Postgres (see docker-compose.yml, or a native install).
# Used by the Next.js app for RLS-scoped tenant queries.
DATABASE_URL=postgresql://popup:popup@localhost:5432/popup_dev

# Used only by db/seed.mjs and the stats aggregation cron: a role created
# with BYPASSRLS, since seeding/aggregation legitimately spans tenants.
# See docs/10-multitenancy.md 2. Never used by request-serving code paths.
DATABASE_SERVICE_URL=postgresql://popup_service:popup_service_dev@localhost:5432/popup_dev

# CDN-facing base URL the SDK and config JSON are served from.
NEXT_PUBLIC_CDN_BASE_URL=http://localhost:3000

# Admin session cookie encryption key (iron-session). Must be >= 32 chars.
# Generate a real one for anything beyond local dev: openssl rand -hex 32
SESSION_SECRET=dev-only-secret-change-me-in-prod-32chars
