{
  "name": "popup-tool",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @popup/web dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:migrate": "node db/migrate.mjs",
    "build:client": "pnpm --filter @popup/loader build && pnpm --filter @popup/sdk build && node scripts/copy-client-dist.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
