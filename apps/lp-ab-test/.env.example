# Separate Supabase project from the popup tool (docs/lp-ab-test/00-requirements.md 9).
# Postgres connection string, used directly via `pg` for all data access —
# no RLS/multitenancy needed (single internal org, role checks happen in
# app code against the `members` table).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lp_ab_test_dev

# Supabase project's Data API base URL + anon/service keys (Project Settings
# > API). anon key powers the browser-side Google OAuth sign-in
# (@supabase/ssr); service role key is used server-side for Storage uploads
# only (apps/lp-ab-test/lib/assets.ts), same pattern as apps/web/lib/assets.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of this admin app (used to build absolute URLs, e.g. in the
# member invite text and the delivery tag snippet shown in the LP detail
# screen).
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3100

# Only @<this domain> Google accounts may ever be treated as valid — enforced
# server-side in lib/require-member.ts in addition to whatever Supabase Auth
# / Google Workspace-level restrictions are configured.
ALLOWED_EMAIL_DOMAIN=primedirect.jp

# Popup tool integration (docs/lp-ab-test/03-popup-integration.md) — Phase 3.
# Left blank until that phase ships; the LP list simply shows no popup-tool
# icon while unset.
POPUP_TOOL_LOOKUP_URL=
POPUP_TOOL_LOOKUP_TOKEN=
POPUP_ADMIN_BASE_URL=
